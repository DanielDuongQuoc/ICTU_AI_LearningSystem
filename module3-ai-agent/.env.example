# ICTU_AI_LearningSystem - Module 3 configuration.
# Copy to .env and adjust.  Never commit real API keys or tokens in this file.

# --- Application ---
APP_NAME=ICTU_AI_LearningSystem_Module3
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8003

# --- Gemini (Google AI Studio) ---
# Set GEMINI_API_KEY in .env or environment ONLY (never commit a real key).
# When GEMINI_API_KEY is set, Module 3 uses Google AI Studio (Gemini) for LLM and Embeddings.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Ollama ---
# Local run: localhost.  docker-compose overrides this to http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
# Seconds to establish the TCP connection / to wait for health probes.
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_HEALTH_TIMEOUT=5
# Low temperature = stable, factual RAG answers.
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=1024
# Transient (HTTP 502/503/504) retries only.
OLLAMA_MAX_RETRIES=1
OLLAMA_RETRY_BACKOFF_S=0.5

# --- ChromaDB ---
# docker-compose overrides this to /app/data/chroma (a named volume)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=learning_documents

# --- Chunking (CHUNK_OVERLAP must be < CHUNK_SIZE) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval (TOP_K must be <= MAX_TOP_K) ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3
MAX_TOP_K=20
MAX_CONTEXT_CHARS=12000

# --- Upload ---
MAX_UPLOAD_SIZE_MB=30

# --- Observability ---
SLOW_REQUEST_THRESHOLD_MS=5000
# --- AI governance (Phase 18) ---
# Admin API (/api/ai-versions) is DISABLED while ADMIN_API_TOKEN is empty. Set it ONLY in the real
# environment / secret store (never commit a value); when set it must be >= 16 characters.
ADMIN_API_TOKEN=
# Folder for version manifests, state and the audit log. docker-compose mounts a volume for it.
AI_VERSIONS_DIR=./data/ai_versions
# Optional JSON policy overriding the promotion-gate defaults; empty = built-in defaults.
AI_GATE_POLICY_FILE=

# --- CORS ---
# Comma-separated allowed origins, e.g. http://localhost:3000. Empty = CORS disabled.
CORS_ALLOWED_ORIGINS=

# --- Request text limits (characters) ---
MAX_QUESTION_CHARS=2000
MAX_ANSWER_CHARS=10000
# --- Backpressure (Phase 16) ---
# Max simultaneous Ollama generation calls (0 = unlimited). Excess calls wait up to LLM_QUEUE_TIMEOUT_S, then get 503 SERVICE_OVERLOADED.
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT_S=30
# Phase 22: embeddings are sent to Ollama in batches of at most EMBEDDING_BATCH_SIZE texts; at most MAX_CONCURRENT_EMBEDDINGS
# embedding calls run at once (0 = unlimited); excess calls wait up to EMBEDDING_QUEUE_TIMEOUT_S, then get 503 SERVICE_OVERLOADED.
EMBEDDING_BATCH_SIZE=64
MAX_CONCURRENT_EMBEDDINGS=4
EMBEDDING_QUEUE_TIMEOUT_S=30
# p95 slowdown (percent) versus a baseline that scripts/perf_regression.py reports as PERFORMANCE REGRESSION.
PERFORMANCE_REGRESSION_THRESHOLD_PERCENT=20
# Max total questions in one exam-matrix generation request.
MAX_MATRIX_QUESTIONS=50
# --- Logging (Phase 16) ---
# DEBUG/INFO/WARNING/ERROR/CRITICAL. Empty = DEBUG when APP_ENV=development, otherwise INFO.
LOG_LEVEL=

# --- Security limits (Phase 19); every value must be > 0 unless stated ---
# Ingestion bounds (a 30 MB PDF can still expand into huge text / many chunks).
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=3000
PDF_PROCESSING_TIMEOUT_S=60
# Simultaneous uploads being processed (0 = unlimited); excess uploads get 503, they are not queued.
MAX_CONCURRENT_UPLOADS=2
# JSON request body cap in bytes (uploads are limited by MAX_UPLOAD_SIZE_MB).
MAX_REQUEST_BODY_BYTES=1048576
# Raw model output cap (characters) and maximum wall-clock seconds of one SSE stream.
MAX_LLM_OUTPUT_CHARS=60000
STREAM_MAX_DURATION_S=300
# Per-client requests/minute on expensive endpoints (0 = disabled). In-process, single instance.
RATE_LIMIT_PER_MINUTE=120

# --- Phase 20: observability / reliability ---
# Stage-level slow warnings (the request-level threshold is SLOW_REQUEST_THRESHOLD_MS).
SLOW_STAGE_THRESHOLD_MS=5000
SLOW_LLM_THRESHOLD_MS=60000
# Whole-request budget in seconds; must be >= OLLAMA_TIMEOUT.
REQUEST_TIMEOUT_S=300
# Readiness fails when the persistence volume has less free space than this (MB).
MIN_FREE_DISK_MB=100
# text | json
LOG_FORMAT=text

# Phase 21 production note: with APP_ENV=production the models must carry explicit, non-latest tags
# (for example OLLAMA_MODEL qwen2.5:7b and OLLAMA_EMBEDDING_MODEL nomic-embed-text:v1.5). Verify with ollama list.
